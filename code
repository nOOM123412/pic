import sys
import subprocess
import asyncio
import requests
from io import BytesIO


def install(package):
    subprocess.check_call([sys.executable, "-m", "pip", "install", package])


# Автоустановка библиотек
packages = [
    "python-telegram-bot",
    "requests",
    "beautifulsoup4"
]

for pkg in packages:
    try:
        __import__(pkg.split("-")[0])
    except:
        print(f"Устанавливаю {pkg}...")
        install(pkg)


from telegram import Update
from telegram.ext import (
    ApplicationBuilder,
    MessageHandler,
    ContextTypes,
    filters
)
from bs4 import BeautifulSoup


# ВСТАВЬ СВОЙ ТОКЕН
TOKEN = "8762386355:AAG3gBPTu3Kq_KYTgbawLKoUnJMqk-HX97Q"


HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/124.0 Safari/537.36"
    )
}


def get_image(query):
    url = f"https://www.google.com/search?tbm=isch&q={query}"

    response = requests.get(url, headers=HEADERS, timeout=10)

    soup = BeautifulSoup(response.text, "html.parser")

    images = soup.find_all("img")

    # Первая картинка обычно логотип Google
    for img in images:
        src = img.get("src")

        if src and src.startswith("http"):
            return src

    return None


async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.message.text

    msg = await update.message.reply_text("Ищу картинку...")

    try:
        image_url = get_image(query)

        if not image_url:
            await msg.edit_text("Картинка не найдена")
            return

        image_data = requests.get(image_url, headers=HEADERS).content

        photo = BytesIO(image_data)
        photo.name = "image.jpg"

        await update.message.reply_photo(photo=photo)

        await msg.delete()

    except Exception as e:
        await msg.edit_text(f"Ошибка: {e}")


def main():
    print("Бот запускается...")

    app = ApplicationBuilder().token(TOKEN).build()

    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            handle_message
        )
    )

    print("Бот запущен!")

    app.run_polling()


if __name__ == "__main__":
    main()
