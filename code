async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Команда /start"""
    await update.message.reply_text(
        'Привет! Отправь мне текст, и я найду для него картинку.'
    )

async def search_image(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Поиск и отправка изображения"""
    query = update.message.text
    
    await update.message.reply_text('⏳ Ищу изображение...')
    
    try:
        # Базовая фильтрация контента
        forbidden_words = ['adult', 'porn', 'xxx', 'sex', 'nude', 'naked', 'nsfw', 'explicit']
        if any(word.lower() in query.lower() for word in forbidden_words):
            await update.message.reply_text('❌ Этот запрос содержит недопустимый контент.')
            return
        
        # Сначала пытаемся DuckDuckGo
        image_url = get_duckduckgo_image(query)
        
        # Если DuckDuckGo не сработал, пытаемся Bing
        if not image_url:
            image_url = get_bing_image(query)
        
        if image_url:
            try:
                await update.message.reply_photo(
                    photo=image_url,
                    caption=f'🖼️ Картинка для: "{query}"'
                )
            except Exception as e:
                logger.error(f"Ошибка отправки фото: {e}")
                await update.message.reply_text(f'⚠️ Не удалось отправить изображение.')
        else:
            await update.message.reply_text('😕 Не удалось найти изображение.')
            
    except Exception as e:
        logger.error(f"Ошибка: {e}")
        await update.message.reply_text('⚠️ Ошибка при поиске изображения.')

def get_duckduckgo_image(query: str) -> str:
    """Поиск первого изображения через DuckDuckGo"""
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
            'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8',
            'Accept-Language': 'en-US,en;q=0.9',
            'Accept-Encoding': 'gzip, deflate, br',
            'DNT': '1',
            'Connection': 'keep-alive',
            'Upgrade-Insecure-Requests': '1',
        }
        
        url = f'https://duckduckgo.com/?q={query}&t=h_&ia=images&iax=images'
        response = requests.get(url, headers=headers, timeout=15)
        response.raise_for_status()
        
        # Поиск URL изображений в JSON
        matches = re.findall(r'"image":"([^"]+)"', response.text)
        
        if matches:
            for match in matches:
                if match and 'http' in match:
                    return match
        
        logger.warning(f"DuckDuckGo: не найдены URL для запроса: {query}")
        return None
        
    except requests.exceptions.RequestException as e:
        logger.error(f"Ошибка запроса DuckDuckGo: {e}")
        return None
    except Exception as e:
        logger.error(f"Неожиданная ошибка DuckDuckGo: {e}")
        return None

def get_bing_image(query: str) -> str:
    """Поиск первого изображения через Bing (резервный вариант)"""
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
            'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8',
            'Accept-Language': 'en-US,en;q=0.9',
            'Accept-Encoding': 'gzip, deflate, br',
            'DNT': '1',
            'Connection': 'keep-alive',
            'Upgrade-Insecure-Requests': '1',
            'Sec-Fetch-Dest': 'document',
            'Sec-Fetch-Mode': 'navigate',
            'Sec-Fetch-Site': 'none',
            'Cache-Control': 'max-age=0',
        }
        
        url = f'https://www.bing.com/images/search?q={query}'
        
        response = requests.get(url, headers=headers, timeout=15)
        response.raise_for_status()
        
        # Поиск URL изображений в JSON
        matches = re.findall(r'"murl":"([^"]+)"', response.text)
        
        if matches:
            for match in matches:
                if match and 'http' in match:
                    return match
        
        logger.warning(f"Bing: не найдены URL для запроса: {query}")
        return None
        
    except requests.exceptions.RequestException as e:
        logger.error(f"Ошибка запроса Bing: {e}")
        return None
    except Exception as e:
        logger.error(f"Неожиданная ошибка Bing: {e}")
        return None

def main():
    """Запуск бота"""
    application = Application.builder().token(TELEGRAM_TOKEN).build()
    
    # Обработчики команд
    application.add_handler(CommandHandler('start', start))
    
    # Обработчик текстовых сообщений
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, search_image))
    
    # Запуск бота
    application.run_polling()

if __name__ == '__main__':
    main()
