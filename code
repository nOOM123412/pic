async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Команда /start"""
    await update.message.reply_text(
        'Привет! Отправь мне текст, и я найду для него картинку.'
    )

async def search_image(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Поиск и отправка изображения"""
    query = update.message.text
    
    await update.message.reply_text('⏳ Ищу изображение...')
    
    try:
        # Базовая фильтрация контента
        forbidden_words = ['adult', 'porn', 'xxx', 'sex', 'nude', 'naked', 'nsfw', 'explicit']
        if any(word.lower() in query.lower() for word in forbidden_words):
            await update.message.reply_text('❌ Этот запрос содержит недопустимый контент.')
            return
        
        # Поиск изображения
        image_url = search_image_url(query)
        
        if image_url:
            try:
                await update.message.reply_photo(
                    photo=image_url,
                    caption=f'🖼️ Картинка для: "{query}"'
                )
                logger.info(f"Успешно найдено изображение для: {query}")
            except Exception as e:
                logger.error(f"Ошибка отправки фото: {e}")
                await update.message.reply_text(f'⚠️ Не удалось отправить изображение.')
        else:
            await update.message.reply_text('😕 Не удалось найти изображение.')
            
    except Exception as e:
        logger.error(f"Критическая ошибка: {e}")
        await update.message.reply_text('⚠️ Ошибка при поиске изображения.')

def search_image_url(query: str) -> str:
    """Поиск изображения через разные методы"""
    
    # Пытаемся Unsplash (самый надежный)
    image_url = get_unsplash_image(query)
    if image_url:
        logger.info(f"Найдено через Unsplash: {image_url}")
        return image_url
    
    # Пытаемся Pexels
    image_url = get_pexels_image(query)
    if image_url:
        logger.info(f"Найдено через Pexels: {image_url}")
        return image_url
    
    # Пытаемся Pixabay
    image_url = get_pixabay_image(query)
    if image_url:
        logger.info(f"Найдено через Pixabay: {image_url}")
        return image_url
    
    return None

def get_unsplash_image(query: str) -> str:
    """Поиск через Unsplash API (свободные изображения)"""
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
        
        url = 'https://api.unsplash.com/search/photos'
        params = {
            'query': query,
            'per_page': 1,
            'client_id': 'fBbNEHWqPEbNxpbYeQCKGz48KzgFzOa_HhqkSjXnqrU'
        }
        
        response = requests.get(url, headers=headers, params=params, timeout=10)
        response.raise_for_status()
        
        data = response.json()
        
        if 'results' in data and len(data['results']) > 0:
            return data['results'][0]['urls']['regular']
        
        logger.warning(f"Unsplash не найдено для: {query}")
        return None
        
    except Exception as e:
        logger.error(f"Ошибка Unsplash: {e}")
        return None

def get_pexels_image(query: str) -> str:
    """Поиск через Pexels API"""
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36',
            'Authorization': 'vE9sTwHWU7H5aLvgXNPE3O4W8D2C7A0B9E1F3G5H'
        }
        
        url = 'https://api.pexels.com/v1/search'
        params = {
            'query': query,
            'per_page': 1
        }
        
        response = requests.get(url, headers=headers, params=params, timeout=10)
        response.raise_for_status()
        
        data = response.json()
        
        if 'photos' in data and len(data['photos']) > 0:
            return data['photos'][0]['src']['original']
        
        logger.warning(f"Pexels не найдено для: {query}")
        return None
        
    except Exception as e:
        logger.error(f"Ошибка Pexels: {e}")
        return None

def get_pixabay_image(query: str) -> str:
    """Поиск через Pixabay API"""
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
        
        url = 'https://pixabay.com/api/'
        params = {
            'q': query,
            'image_type': 'photo',
            'per_page': 3,
            'key': '48036849-5e16d88bfe96ce68f45f87c7a'
        }
        
        response = requests.get(url, headers=headers, params=params, timeout=10)
        response.raise_for_status()
        
        data = response.json()
        
        if 'hits' in data and len(data['hits']) > 0:
            return data['hits'][0]['webformatURL']
        
