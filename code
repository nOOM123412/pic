WELCOME_TEXT = """
Добро пожаловать в UDD team!

Для вступления заполните форму ниже:

• Опыт работы.
• Откуда узнали о нас?
• Какое время уделяете работе?
"""

# =====================================
# START
# =====================================

@dp.message(CommandStart())
async def start_handler(message: Message):
    user_id = message.from_user.id

    if user_id in approved_users:
        await message.answer(
            "Главное меню:",
            reply_markup=main_menu()
        )
        return

    await message.answer(WELCOME_TEXT)

# =====================================
# АНКЕТА
# =====================================

@dp.message()
async def form_handler(message: Message):
    user_id = message.from_user.id

    if user_id in approved_users:
        return

    user_forms[user_id] = message.text

    text = f"""
Ваша заявка выглядит так:

• {message.text}

Всё верно?
"""

    await message.answer(
        text,
        reply_markup=form_keyboard()
    )

# =====================================
# ЗАНОВО
# =====================================

@dp.callback_query(F.data == "restart_form")
async def restart_form(callback: CallbackQuery):

    await callback.message.delete()

    await callback.message.answer(WELCOME_TEXT)

    await callback.answer()

# =====================================
# ОТПРАВИТЬ
# =====================================

@dp.callback_query(F.data == "send_form")
async def send_form(callback: CallbackQuery):
    user_id = callback.from_user.id

    await callback.answer("Заявка отправлена!")

    await callback.message.delete()

    await asyncio.sleep(5)

    approved_users.add(user_id)

    await callback.message.answer(
        "Главное меню:",
        reply_markup=main_menu()
    )

