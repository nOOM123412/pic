import sys
import subprocess
import requests
import os


def install(package):
    subprocess.check_call([sys.executable, "-m", "pip", "install", package])


# Автоустановка библиотек
packages = [
    "python-telegram-bot",
    "requests"
]

for pkg in packages:
    try:
        __import__(pkg.split("-")[0])
    except:
        print(f"Устанавливаю {pkg}...")
        install(pkg)


from telegram import Update
from telegram.ext import (
    ApplicationBuilder,
    MessageHandler,
    ContextTypes,
    filters
)


# ВСТАВЬ СВОЙ ТОКЕН
TOKEN = "8762386355:AAG3gBPTu3Kq_KYTgbawLKoUnJMqk-HX97Q"

HEADERS = {
    "User-Agent": "Mozilla/5.0"
}


def download_image(query):
    url = f"https://source.unsplash.com/600x400/?{query}"

    response = requests.get(
        url,
        headers=HEADERS,
        timeout=20,
        allow_redirects=True
    )

    image_path = "image.jpg"

    with open(image_path, "wb") as f:
        f.write(response.content)

    return image_path


async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.message.text

    msg = await update.message.reply_text(f"Ищу: {query}")

    try:
        image_path = download_image(query)

        if not os.path.exists(image_path):
            await msg.edit_text("Не удалось скачать картинку")
            return

        with open(image_path, "rb") as photo:
            await update.message.reply_photo(photo=photo)

        await msg.delete()

        # Удаляем файл после отправки
        os.remove(image_path)

    except Exception as e:
        await msg.edit_text(f"Ошибка: {e}")


def main():
    print("Бот запускается...")

    app = ApplicationBuilder().token(TOKEN).build()

    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            handle_message
        )
    )

    print("Бот запущен!")

    app.run_polling()


if __name__ == "__main__":
    main()
