import io
import logging
import requests
from PIL import Image
from duckduckgo_search import ddg_images
from telegram import Update
from telegram.ext import ApplicationBuilder, CommandHandler, MessageHandler, ContextTypes, filters

# Настройте эти переменные
TELEGRAM_TOKEN = "8762386355:AAG3gBPTu3Kq_KYTgbawLKoUnJMqk-HX97Q"

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Бот запущен. Отправьте любой текст — я пришлю первую картинку из поиска.")

async def handle_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.message.text.strip()
    if not query:
        await update.message.reply_text("Пустой запрос.")
        return

    await update.message.chat.send_action(action="upload_photo")

    try:
        # ddg_images возвращает список результатов; берем первый
        results = ddg_images(query, max_results=5)
        if not results:
            await update.message.reply_text("Картинки не найдены.")
            return

        first = results[0]
        img_url = first.get("image") or first.get("thumbnail") or first.get("url")
        if not img_url:
            await update.message.reply_text("Не удалось получить URL картинки.")
            return

        # Скачиваем картинку
        resp = requests.get(img_url, timeout=15)
        resp.raise_for_status()
        content_type = resp.headers.get("Content-Type", "").lower()

        # Если SVG или другой неподдерживаемый тип — пытаемся отправить как документ
        if "svg" in content_type or content_type == "application/octet-stream":
            bio = io.BytesIO(resp.content)
            bio.name = "image.svg"
            bio.seek(0)
            await update.message.reply_document(bio)
            return

        # Для безопасной отправки конвертируем в JPEG/PNG через PIL (если формат поддерживаем)
        try:
            img = Image.open(io.BytesIO(resp.content)).convert("RGB")
            out = io.BytesIO()
            img.save(out, format="JPEG", quality=85)
            out.name = "image.jpg"
            out.seek(0)
            await update.message.reply_photo(out)
        except Exception:
            # Если PIL не справился, отправим сырые байты как документ
            bio = io.BytesIO(resp.content)
            bio.name = "image"
            bio.seek(0)
            await update.message.reply_document(bio)
    except Exception as e:
        logger.exception("Ошибка при обработке запроса")
        await update.message.reply_text("Произошла ошибка при поиске/загрузке картинки.")

def main():
    app = ApplicationBuilder().token(TELEGRAM_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))

    app.run_polling()

if __name__ == "__main__":
    main()
