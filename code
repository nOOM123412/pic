import sys
import subprocess
import requests
from io import BytesIO


def install(package):
    subprocess.check_call([sys.executable, "-m", "pip", "install", package])


# Автоустановка библиотек
packages = [
    "python-telegram-bot",
    "requests"
]

for pkg in packages:
    try:
        __import__(pkg.split("-")[0])
    except:
        print(f"Устанавливаю {pkg}...")
        install(pkg)


from telegram import Update
from telegram.ext import (
    ApplicationBuilder,
    MessageHandler,
    ContextTypes,
    filters
)


# ВСТАВЬ СЮДА ТОКЕН
TOKEN = "8762386355:AAG3gBPTu3Kq_KYTgbawLKoUnJMqk-HX97Q"


HEADERS = {
    "User-Agent": "Mozilla/5.0"
}


def get_image(query):
    url = f"https://source.unsplash.com/featured/?{query}"

    response = requests.get(
        url,
        headers=HEADERS,
        timeout=15,
        allow_redirects=True
    )

    # Финальная ссылка на изображение
    return response.url


async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.message.text

    msg = await update.message.reply_text("Ищу картинку...")

    try:
        image_url = get_image(query)

        image_data = requests.get(
            image_url,
            headers=HEADERS,
            timeout=15
        ).content

        photo = BytesIO(image_data)
        photo.name = "image.jpg"

        await update.message.reply_photo(photo=photo)

        await msg.delete()

    except Exception as e:
        await msg.edit_text(f"Ошибка: {e}")


def main():
    print("Бот запускается...")

    app = ApplicationBuilder().token(TOKEN).build()

    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            handle_message
        )
    )

    print("Бот запущен!")

    app.run_polling()


if __name__ == "__main__":
    main()
