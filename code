import sys
import subprocess
import requests


def install(package):
    subprocess.check_call([sys.executable, "-m", "pip", "install", package])


# Автоустановка библиотек
packages = [
    "python-telegram-bot",
    "requests"
]

for pkg in packages:
    try:
        __import__(pkg.split("-")[0])
    except:
        print(f"Устанавливаю {pkg}...")
        install(pkg)


from telegram import Update
from telegram.ext import (
    ApplicationBuilder,
    MessageHandler,
    ContextTypes,
    filters
)


# ==================================
# НАСТРОЙКИ
# ==================================

TOKEN = "8762386355:AAG3gBPTu3Kq_KYTgbawLKoUnJMqk-HX97Q"

# Получить API ключ:
# https://pixabay.com/api/docs/
PIXABAY_API_KEY = "56006060-61891714dc94c024fdc783176"


# ==================================
# ПОИСК КАРТИНКИ
# ==================================

def search_image(query):
    url = "https://pixabay.com/api/"

    params = {
        "key": PIXABAY_API_KEY,
        "q": query,
        "image_type": "photo",
        "per_page": 3,
        "safesearch": "true"
    }

    response = requests.get(
        url,
        params=params,
        timeout=15
    )

    data = response.json()

    hits = data.get("hits")

    if not hits:
        return None

    # largeImageURL / webformatURL
    return hits[0]["largeImageURL"]


# ==================================
# ОБРАБОТКА СООБЩЕНИЙ
# ==================================

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.message.text

    msg = await update.message.reply_text(
        f"Ищу картинку: {query}"
    )

    try:
        image_url = search_image(query)

        if not image_url:
            await msg.edit_text("Картинка не найдена")
            return

        # Telegram сам загрузит фото
        await update.message.reply_photo(photo=image_url)

        await msg.delete()

    except Exception as e:
        await msg.edit_text(f"Ошибка: {e}")


# ==================================
# ЗАПУСК
# ==================================

def main():
    print("Бот запускается...")

    app = ApplicationBuilder().token(TOKEN).build()

    app.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            handle_message
        )
    )

    print("Бот запущен!")

    app.run_polling()


if __name__ == "__main__":
    main()
