TARGET_BOT = "KRKM_robot"

# ==================================================

tg_client = TelegramClient(
    "session",
    API_ID,
    API_HASH
)

user_states = {}


async def build_keyboard(message):
    if not message.buttons:
        return None

    keyboard = []

    for row_i, row in enumerate(message.buttons):
        buttons = []

        for col_i, btn in enumerate(row):
            buttons.append(
                InlineKeyboardButton(
                    text=btn.text,
                    callback_data=f"{row_i}:{col_i}"
                )
            )

        keyboard.append(buttons)

    return InlineKeyboardMarkup(keyboard)


async def send_new_message(
    user_id,
    response,
    context
):
    state = user_states.get(user_id)

    # удаляем старое сообщение
    if state:
        old_msg = state.get("message_id")

        if old_msg:
            try:
                await context.bot.delete_message(
                    chat_id=user_id,
                    message_id=old_msg
                )
            except:
                pass

    markup = await build_keyboard(response)

    sent = await context.bot.send_message(
        chat_id=user_id,
        text=response.text or "Пустое сообщение",
        reply_markup=markup
    )

    user_states[user_id] = {
        "message_id": sent.message_id,
        "telethon_message": response
    }


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id

    async with tg_client.conversation(TARGET_BOT) as conv:
        await conv.send_message("/start")

        response = await conv.get_response()

    await send_new_message(
        user_id,
        response,
        context
    )


async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query

    await query.answer()

    user_id = query.from_user.id

    state = user_states.get(user_id)

    if not state:
        return

    telethon_message = state["telethon_message"]

    row_i, col_i = map(int, query.data.split(":"))

    try:
        await telethon_message.click(
            row_i,
            col_i
        )

        async with tg_client.conversation(TARGET_BOT) as conv:
            response = await conv.get_response()

        await send_new_message(
            user_id,
            response,
            context
        )

    except Exception as e:
        await context.bot.send_message(
            chat_id=user_id,
            text=f"Ошибка:\n{e}"
        )


async def main():
    await tg_client.start()

    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(
        CommandHandler("start", start)
    )

    app.add_handler(
        CallbackQueryHandler(button_handler)
    )

    print("BOT STARTED")

    await app.initialize()
    await app.start()
    await app.updater.start_polling()

    while True:
        await asyncio.sleep(1)


if __name__ == "__main__":
    asyncio.run(main())
