import logging
import requests
import re
from telegram import Update
from telegram.ext import Application, CommandHandler, MessageHandler, filters, ContextTypes

# Настройка логирования
logging.basicConfig(
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    level=logging.INFO
)
logger = logging.getLogger(__name__)

# Замени на свой токен
TELEGRAM_TOKEN = '8762386355:AAG3gBPTu3Kq_KYTgbawLKoUnJMqk-HX97Q'

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Команда /start"""
    await update.message.reply_text(
        'Привет! Отправь мне текст, и я найду для него картинку.'
    )

async def search_image(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Поиск и отправка изображения"""
    query = update.message.text
    
    await update.message.reply_text('⏳ Ищу изображение...')
    
    try:
        # Базовая фильтрация контента
        forbidden_words = ['adult', 'porn', 'xxx', 'sex', 'nude', 'naked', 'nsfw', 'explicit']
        if any(word.lower() in query.lower() for word in forbidden_words):
            await update.message.reply_text('❌ Этот запрос содержит недопустимый контент.')
            return
        
        # Поиск через Bing
        image_url = get_bing_image(query)
        
        if image_url:
            await update.message.reply_photo(
                photo=image_url,
                caption=f'🖼️ Картинка для: "{query}"'
            )
        else:
            await update.message.reply_text('😕 Не удалось найти изображение.')
            
    except Exception as e:
        logger.error(f"Ошибка: {e}")
        await update.message.reply_text('⚠️ Ошибка при поиске изображения.')

def get_bing_image(query: str) -> str:
    """Поиск первого изображения через Bing"""
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
        }
        
        url = f'https://www.bing.com/images/search?q={query}'
        
        response = requests.get(url, headers=headers, timeout=10)
        response.raise_for_status()
        
        # Поиск URL изображений в JSON
        matches = re.findall(r'"murl":"([^"]+)"', response.text)
        
        if matches:
            # Возвращаем первое найденное изображение
            return matches[0]
        
        return None
        
    except Exception as e:
        logger.error(f"Ошибка Bing: {e}")
        return None

def main():
    """Запуск бота"""
    application = Application.builder().token(TELEGRAM_TOKEN).build()
    
    # Обработчики команд
    application.add_handler(CommandHandler('start', start))
    
    # Обработчик текстовых сообщений
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, search_image))
    
    # Запуск бота
    application.run_polling()

if __name__ == '__main__':
    main()
