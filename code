async def search_image(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Поиск и отправка изображения"""
    query = update.message.text
    
    await update.message.reply_text('⏳ Ищу изображение...')
    
    try:
        # Базовая фильтрация контента
        forbidden_words = ['adult', 'porn', 'xxx', 'sex', 'nude', 'naked', 'nsfw', 'explicit']
        if any(word.lower() in query.lower() for word in forbidden_words):
            await update.message.reply_text('❌ Этот запрос содержит недопустимый контент.')
            return
        
        # Поиск изображения
        image_url = search_image_url(query)
        
        if image_url:
            try:
                await update.message.reply_photo(
                    photo=image_url,
                    caption=f'🖼️ Картинка для: "{query}"'
                )
            except Exception as e:
                logger.error(f"Ошибка отправки фото: {e}")
                await update.message.reply_text(f'⚠️ Не удалось отправить изображение.')
        else:
            await update.message.reply_text('😕 Не удалось найти изображение.')
            
    except Exception as e:
        logger.error(f"Ошибка: {e}")
        await update.message.reply_text('⚠️ Ошибка при поиске изображения.')

def search_image_url(query: str) -> str:
    """Поиск изображения через разные методы"""
    
    # Пытаемся Bing Images API
    image_url = get_bing_image_api(query)
    if image_url:
        return image_url
    
    # Пытаемся через Google Custom Search (нужен API ключ)
    image_url = get_google_image(query)
    if image_url:
        return image_url
    
    # Пытаемся через Pixabay (свободные изображения)
    image_url = get_pixabay_image(query)
    if image_url:
        return image_url
    
    return None

def get_bing_image_api(query: str) -> str:
    """Поиск через Bing Images с правильным парсингом"""
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
        }
        
        # Используем API который возвращает JSON
        url = f'https://api.search.yahoo.com/site/image'
        params = {
            'p': query,
            'format': 'json'
        }
        
        response = requests.get(url, headers=headers, params=params, timeout=15)
        
        if response.status_code == 200:
            try:
                data = response.json()
                if 'results' in data and len(data['results']) > 0:
                    return data['results'][0]['url']
            except:
                pass
        
        return None
        
    except Exception as e:
        logger.error(f"Ошибка Bing API: {e}")
        return None

def get_google_image(query: str) -> str:
    """Поиск через Google Images"""
    try:
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
        
        # Прямой поиск в Google
        url = f'https://www.google.com/search?q={quote(query)}&tbm=isch&ijn=0'
        response = requests.get(url, headers=headers, timeout=15)
        
        if response.status_code == 200:
            # Ищем первый img src
            import re
            matches = re.findall(r'src="(https?://[^"]+\.(?:jpg|jpeg|png|gif|webp))"', response.text)
            if matches:
                for match in matches:
                    if 'gstatic' not in match and 'google' not in match:
                        return match
        
        return None
        
    except Exception as e:
        logger.error(f"Ошибка Google: {e}")
        return None

def get_pixabay_image(query: str) -> str:
    """Поиск через Pixabay (свободные изображения без лицензии)"""
    try:
        # Если у тебя есть API ключ Pixabay, подставь его
        # Получить можно здесь: https://pixabay.com/api/docs/
        # API_KEY = 'твой_ключ_здесь'
        
        # Без API ключа используем простой парсинг
        headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36'
        }
        
        url = f'https://pixabay.com/api/'
        params = {
            'q': query,
            'image_type': 'photo',
            'pretty': 'true'
        }
        
        response = requests.get(url, headers=headers, params=params, timeout=15)
        
        if response.status_code == 200:
            try:
                data = response.json()
                if 'hits' in data and len(data['hits']) > 0:
                    return data['hits'][0]['webformatURL']
            except:
                pass
        
        return None
        
    except Exception as e:
        logger.error(f"Ошибка Pixabay: {e}")
        return None

def main():
    """Запуск бота"""
    application = Application.builder().token(TELEGRAM_TOKEN).build()
    
    # Обработчики команд
    application.add_handler(CommandHandler('start', start))
    
    # Обработчик текстовых сообщений
    application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, search_image))
    
    # Запуск бота
    application.run_polling()

if __name__ == '__main__':
    main()
