        subprocess.check_call(
            [sys.executable, "-m", "pip", "install", package]
        )

# ==========================================
# ИМПОРТЫ
# ==========================================

import asyncio

from telethon import TelegramClient

from telegram import (
    InlineKeyboardButton,
    InlineKeyboardMarkup,
    Update,
)

from telegram.ext import (
    Application,
    CommandHandler,
    CallbackQueryHandler,
    ContextTypes,
)

# ==========================================
# НАСТРОЙКИ
# ==========================================

BOT_TOKEN = "8790161123:AAGHF8QlwAJ9RhVS9PIGqyD0aIvTB8IG6gc"

# ПУБЛИЧНЫЙ API
API_ID = 6
API_HASH = "eb06d4abfb49dc3eeb1aeb98ae0f581e"

TARGET_BOT = "KRKM_robot"

# ==========================================

tg_client = TelegramClient(
    "session",
    API_ID,
    API_HASH
)

user_states = {}

# ==========================================
# СОЗДАНИЕ КНОПОК
# ==========================================

async def build_keyboard(message):
    if not message.buttons:
        return None

    keyboard = []

    for row_i, row in enumerate(message.buttons):
        row_buttons = []

        for col_i, btn in enumerate(row):
            row_buttons.append(
                InlineKeyboardButton(
                    text=btn.text,
                    callback_data=f"{row_i}:{col_i}"
                )
            )

        keyboard.append(row_buttons)

    return InlineKeyboardMarkup(keyboard)

# ==========================================
# ОТПРАВКА СООБЩЕНИЯ
# ==========================================

async def send_new_message(
    user_id,
    response,
    context
):
    state = user_states.get(user_id)

    # удаление старого сообщения
    if state:
        old_message_id = state.get("message_id")

        if old_message_id:
            try:
                await context.bot.delete_message(
                    chat_id=user_id,
                    message_id=old_message_id
                )
            except:
                pass

    markup = await build_keyboard(response)

    sent = await context.bot.send_message(
        chat_id=user_id,
        text=response.text or "Пустое сообщение",
        reply_markup=markup
    )

    user_states[user_id] = {
        "message_id": sent.message_id,
        "telethon_message": response
    }

# ==========================================
# /start
# ==========================================

async def start(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    user_id = update.effective_user.id

    async with tg_client.conversation(TARGET_BOT) as conv:
        await conv.send_message("/start")

        response = await conv.get_response()

    await send_new_message(
        user_id,
        response,
        context
    )

# ==========================================
# ОБРАБОТКА КНОПОК
# ==========================================

async def button_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE
):
    query = update.callback_query

    await query.answer()

    user_id = query.from_user.id

    state = user_states.get(user_id)

    if not state:
        return

    telethon_message = state["telethon_message"]

    row_i, col_i = map(
        int,
        query.data.split(":")
    )

    try:
        # нажатие кнопки
        await telethon_message.click(
            row_i,
            col_i
        )

        # получение нового ответа
        async with tg_client.conversation(TARGET_BOT) as conv:
            response = await conv.get_response()

        await send_new_message(
            user_id,
            response,
            context
        )

    except Exception as e:
        await context.bot.send_message(
            chat_id=user_id,
            text=f"Ошибка:\n{e}"
        )

# ==========================================
# MAIN
# ==========================================

async def main():

    print("Запуск userbot...")

    await tg_client.start()

    print("Userbot авторизован")

    app = Application.builder().token(
        BOT_TOKEN
    ).build()

    app.add_handler(
        CommandHandler("start", start)
    )

    app.add_handler(
        CallbackQueryHandler(button_handler)
    )

    print("BOT STARTED")

    await app.initialize()
    await app.start()
    await app.updater.start_polling()

    while True:
        await asyncio.sleep(1)

# ==========================================

if __name__ == "__main__":
    asyncio.run(main())
