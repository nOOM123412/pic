import requests

from telegram import Update
from telegram.ext import (
    Application,
    CommandHandler,
    MessageHandler,
    filters,
    ContextTypes,
)

BOT_TOKEN = "8762386355:AAG3gBPTu3Kq_KYTgbawLKoUnJMqk-HX97Q"
PEXELS_API_KEY = "JRop9GKeIZRUd8X1Fn7b3861mqzPsE1LFf8DgdbxMcCgKEJT0zYeT4H7"


# /start
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("Привет! Это MasterAuto")


# Поиск картинки
async def search_image(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.message.text

    url = "https://api.pexels.com/v1/search"

    headers = {
        "Authorization": PEXELS_API_KEY
    }

    params = {
        "query": query,
        "per_page": 1
    }

    try:
        response = requests.get(url, headers=headers, params=params)
        data = response.json()

        photos = data.get("photos")

        if photos:
            image_url = photos[0]["src"]["large"]

            await context.bot.send_photo(
                chat_id=update.effective_chat.id,
                photo=image_url,
                caption=f"Результат по запросу: {query}"
            )
        else:
            await update.message.reply_text("Картинка не найдена.")

    except Exception as e:
        await update.message.reply_text(f"Ошибка: {e}")


def main():
    app = Application.builder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, search_image))

    print("Бот запущен")
    app.run_polling()


if __name__ == "__main__":
    main()
