Добро пожаловать в UDD team!

Для вступления заполните форму ниже:

• Опыт работы.
• Откуда узнали о нас?
• Какое время уделяете работе?
"""

# =====================================
# START
# =====================================

@dp.message(CommandStart())
async def start_handler(message: Message):

    user_id = message.from_user.id

    # Если пользователь уже прошёл модерацию
    if user_id in approved_users:

        await send_main_menu(
            message.chat.id
        )

        return

    # Новый пользователь
    await message.answer(
        WELCOME_TEXT
    )

# =====================================
# АНКЕТА
# =====================================

@dp.message(F.text)
async def form_handler(message: Message):

    user_id = message.from_user.id

    # Игнорируем команды
    if message.text.startswith("/"):
        return

    # Игнорируем пользователей
    # прошедших модерацию
    if user_id in approved_users:
        return

    # Сохраняем анкету
    user_forms[user_id] = message.text

    text = f"""
Ваша заявка выглядит так:

• {message.text}

Всё верно?
"""

    await message.answer(
        text,
        reply_markup=form_keyboard()
    )

# =====================================
# ЗАНОВО
# =====================================

@dp.callback_query(
    F.data == "restart_form"
)
async def restart_form(
    callback: CallbackQuery
):

    await callback.message.delete()

    await callback.message.answer(
        WELCOME_TEXT
    )

    await callback.answer()

# =====================================
# ОТПРАВИТЬ
# =====================================

@dp.callback_query(
    F.data == "send_form"
)
async def send_form(
    callback: CallbackQuery
):

    user_id = callback.from_user.id

    await callback.answer(
        "Заявка отправлена!"
    )

    await callback.message.delete()

    # Ждём 5 секунд
    await asyncio.sleep(5)

    # Добавляем пользователя
    approved_users.add(user_id)

    # Открываем меню
    await send_main_menu(
        callback.message.chat.id
    )

